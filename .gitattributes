# Binary assets and validation screenshots stay binary in Git.
/.gitattributes text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.mp4 binary

# I3 Base originals and content-addressed art objects retain source bytes.
/sources/base/原始策划案/** binary
/sources/base/美术素材/blobs/** binary
/sources/base/manifests/*.csv text eol=lf
/sources/base/manifests/*.json text eol=lf

# Godot binary resources should not be line-ending normalized.
*.res binary

# I1 byte-level HEAD provenance requires deterministic control-plane bytes.
/tools/i1/validation_manifest.json text eol=lf
/tools/i1/invoke_i1.ps1 text eol=lf
/tools/i1/invoke_i1_preview.ps1 text eol=lf
/tools/i0/i0_test_lib.ps1 text eol=lf

# Generated governance overlays are canonical LF text.  The verifier also
# normalizes checkout line endings so existing Windows worktrees remain valid.
/docs/00_governance/I3R_BASE_SEMANTIC_OBJECT_REGISTRY.csv text eol=lf
/docs/00_governance/I3R_BASE_RUNTIME_CROSSWALK.csv text eol=lf
/docs/00_governance/I3R_BASE_RUNTIME_ALIAS_DEBT.csv text eol=lf
