{
  "schema_version": 2,
  "suite_id": "I0.2_characterization_baseline",
  "path_policy": "runtime_parameters",
  "powershell": {
    "edition": "Desktop",
    "major": 5,
    "minimum_version": "5.1"
  },
  "godot": {
    "version_prefix": "4.6.3.stable",
    "main_executable": "Godot_v4.6.3-stable_win64.exe",
    "console_executable": "Godot_v4.6.3-stable_win64_console.exe",
    "project_relative_path": "Godot/GraytailGodot",
    "environment_probe_relative_path": "tools/i0/godot_i0_environment_probe.gd"
  },
  "mirror": {
    "worktree_directory": "worktree",
    "excluded_directory_names": [
      ".git",
      ".godot",
      "__pycache__"
    ]
  },
  "business_roots": [
    "Godot/GraytailGodot"
  ],
  "profiles": {
    "baseline": {
      "expected_red_codes": [
        "SAVE_ABANDON_COUNT",
        "CSV_ASSET_MANIFEST_WIDTH",
        "INPUT_REQUIRED_ACTIONS",
        "DEBUG_SURFACE_TOGGLES"
      ]
    },
    "remediated": {
      "expected_red_codes": []
    }
  },
  "static_contract": {
    "expected_runner_case_count": 12,
    "save_adapter_relative_path": "Godot/GraytailGodot/scripts/core/save/save_adapter.gd",
    "asset_catalog_relative_path": "Godot/GraytailGodot/scripts/core/content/asset_catalog.gd",
    "asset_manifest_relative_path": "Godot/GraytailGodot/data/assets/asset_manifest.csv",
    "project_settings_relative_path": "Godot/GraytailGodot/project.godot",
    "run_scene_relative_path": "Godot/GraytailGodot/scripts/core/run/run_scene.gd",
    "document_encoding_validator_relative_path": "tools/i0/validate_document_encoding.ps1",
    "required_input_actions": [
      "open_inventory",
      "open_ground_loot",
      "request_extract"
    ],
    "required_project_markers": [
      "config_version=5",
      "run/main_scene=\"res://scenes/main/main.tscn\""
    ],
    "allowed_project_feature_markers": {
      "worktree": [
        "config/features=PackedStringArray(\"4.0\")",
        "config/features=PackedStringArray(\"4.6\")"
      ],
      "head": [
        "config/features=PackedStringArray(\"4.0\")"
      ]
    },
    "asset_manifest_expected_headers": [
      "asset_id",
      "source_repo_path",
      "godot_path",
      "type",
      "category",
      "usage",
      "import_preset",
      "license_status",
      "replacement_needed",
      "linked_scene",
      "linked_data",
      "note",
      "theme_key",
      "presentation_role",
      "state",
      "variant",
      "source_status"
    ],
    "asset_manifest_expected_data_row_count": 388,
    "asset_manifest_required_headers": [
      "asset_id",
      "godot_path",
      "replacement_needed",
      "theme_key",
      "presentation_role",
      "state",
      "variant",
      "source_status"
    ]
  },
  "runners": [
    {
      "id": "G37_COMMAND_SEQUENCE",
      "relative_path": "tools/godot_g37_command_sequence_runner.gd",
      "pass_marker": "G37_COMMAND_SEQUENCE_REGRESSION=PASS",
      "fail_marker": "G37_COMMAND_SEQUENCE_REGRESSION=FAIL",
      "coverage": ["command", "runtime", "extraction"]
    },
    {
      "id": "G39_NAVIGATION_BOUNDARY",
      "relative_path": "tools/godot_g39_navigation_boundary_runner.gd",
      "pass_marker": "G39_NAVIGATION_BOUNDARY=PASS",
      "fail_marker": "G39_NAVIGATION_BOUNDARY=FAIL",
      "coverage": ["ui", "navigation", "abandon"]
    },
    {
      "id": "I04_RUN_SCENE_CONTRACT",
      "relative_path": "tools/godot_i04_run_scene_contract_runner.gd",
      "pass_marker": "I04_RUN_SCENE_CONTRACT=PASS",
      "fail_marker": "I04_RUN_SCENE_CONTRACT=FAIL",
      "coverage": ["scene", "signals", "input", "modal", "persistence_boundary"]
    },
    {
      "id": "I04_ART21R2_NO_FLAGS",
      "relative_path": "tools/godot_i04_run_scene_contract_runner.gd",
      "pass_marker": "I04_ART21R2_NO_FLAGS=PASS",
      "fail_marker": "I04_ART21R2_NO_FLAGS=FAIL",
      "user_args": ["--i04-case=no_flags"],
      "coverage": ["scene", "debug_gate", "art21r2_smoke_negative"]
    },
    {
      "id": "I04_ART21R2_MODAL",
      "relative_path": "tools/godot_i04_run_scene_contract_runner.gd",
      "pass_marker": "I04_ART21R2_MODAL=PASS",
      "fail_marker": "I04_ART21R2_MODAL=FAIL",
      "user_args": ["--i04-case=modal", "--art21r2-seed-modal-items"],
      "coverage": ["scene", "debug_gate", "art21r2_modal_seed"]
    },
    {
      "id": "I04_ART21R2_FULL_MAP",
      "relative_path": "tools/godot_i04_run_scene_contract_runner.gd",
      "pass_marker": "I04_ART21R2_FULL_MAP=PASS",
      "fail_marker": "I04_ART21R2_FULL_MAP=FAIL",
      "user_args": ["--i04-case=full_map", "--art21r2-seed-map-markers"],
      "coverage": ["scene", "debug_gate", "art21r2_full_map_seed"]
    },
    {
      "id": "I04_ART21R2_SPARSE_MAP",
      "relative_path": "tools/godot_i04_run_scene_contract_runner.gd",
      "pass_marker": "I04_ART21R2_SPARSE_MAP=PASS",
      "fail_marker": "I04_ART21R2_SPARSE_MAP=FAIL",
      "user_args": ["--i04-case=sparse_map", "--art21r2-seed-map-sparse-markers"],
      "coverage": ["scene", "debug_gate", "art21r2_sparse_map_seed"]
    },
    {
      "id": "M2_LUA_UE_EFFECT_FIRST_LOOP",
      "relative_path": "tools/godot_m2_lua_ue_effect_first_runner.gd",
      "pass_marker": "M2_LUA_UE_EFFECT_FIRST_LOOP=PASS",
      "fail_marker": "M2_LUA_UE_EFFECT_FIRST_LOOP=FAIL",
      "coverage": ["rules", "effects", "parity"]
    },
    {
      "id": "M3_MINIMUM_ITEM_DROP_LOOP",
      "relative_path": "tools/godot_m3_minimum_item_drop_loop_runner.gd",
      "pass_marker": "M3_MINIMUM_ITEM_DROP_LOOP=PASS",
      "fail_marker": "M3_MINIMUM_ITEM_DROP_LOOP=FAIL",
      "coverage": ["items", "drop_loop", "settlement"]
    },
    {
      "id": "M3H_ITEM_LOOP_HARDENING",
      "relative_path": "tools/godot_m3h_item_loop_hardening_runner.gd",
      "pass_marker": "M3H_ITEM_LOOP_HARDENING=PASS",
      "fail_marker": "M3H_ITEM_LOOP_HARDENING=FAIL",
      "coverage": ["items", "hardening", "abandon"]
    },
    {
      "id": "M3R_ITEM_USABILITY_COMPLETION",
      "relative_path": "tools/godot_m3r_item_usability_completion_runner.gd",
      "pass_marker": "M3R_ITEM_USABILITY_COMPLETION=PASS",
      "fail_marker": "M3R_ITEM_USABILITY_COMPLETION=FAIL",
      "coverage": ["items", "warehouse", "loadout"]
    },
    {
      "id": "M5_ITEM_DROP_LOOP_FULL_CONTENT",
      "relative_path": "tools/godot_m5_item_drop_loop_full_content_runner.gd",
      "pass_marker": "M5_ITEM_DROP_LOOP_FULL_CONTENT=PASS",
      "fail_marker": "M5_ITEM_DROP_LOOP_FULL_CONTENT=FAIL",
      "coverage": ["items", "content", "ground_loot"]
    }
  ],
  "timeouts_seconds": {
    "mirror_copy": 600,
    "document_encoding": 60,
    "static_validation": 120,
    "editor_bootstrap": 180,
    "environment_probe": 120,
    "runner": 180,
    "git_probe": 30
  }
}
